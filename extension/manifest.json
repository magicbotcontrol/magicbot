{
  "manifest_version": 3,
  "name": "MagicBot Executor",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://*.iqoption.com/*", "https://*.supabase.co/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.iqoption.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
